{
  "type": "record",
  "name": "TenantProvisioningStatusEventEnvelope",
  "namespace": "com.proactivedevs.contracts.tenants.websocket.v1",
  "doc": "Envelope for tenant provisioning status events sent via WebSocket",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique identifier for this event (UUID)"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "tenant.provisioning.status",
      "doc": "Type of event"
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO 8601 timestamp when the event occurred"
    },
    {
      "name": "correlationId",
      "type": "string",
      "doc": "Correlation ID for tracing requests across services"
    },
    {
      "name": "payload",
      "type": "TenantProvisioningStatusAvro",
      "doc": "Provisioning status data payload"
    },
    {
      "name": "metadata",
      "type": [
        "null",
        {
          "type": "map",
          "values": "string"
        }
      ],
      "default": null,
      "doc": "Optional metadata"
    }
  ]
}