{
  "type": "record",
  "name": "TenantProvisioningStatusAvro",
  "namespace": "com.proactivedevs.contracts.tenants.websocket.v1",
  "doc": "Schema representing the payload for a tenant provisioning status event",
  "fields": [
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Identifier of the tenant being provisioned"
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "ProvisioningStatusEnum",
        "namespace": "com.proactivedevs.contracts.tenants.websocket.v1",
        "doc": "Current lifecycle stage of tenant provisioning",
        "symbols": [
          "PENDING",
          "VALIDATING",
          "PROVISIONING",
          "CONFIGURING",
          "COMPLETED",
          "FAILED"
        ]
      },
      "doc": "Current lifecycle stage"
    },
    {
      "name": "progress",
      "type": ["null", "int"],
      "default": null,
      "doc": "Completion percentage (0-100)"
    },
    {
      "name": "step",
      "type": ["null", "string"],
      "default": null,
      "doc": "Technical step being executed"
    },
    {
      "name": "details",
      "type": ["null", "string"],
      "default": null,
      "doc": "Human-readable explanation of the current status"
    },
    {
      "name": "error",
      "type": ["null", "ProvisioningErrorAvro"],
      "default": null,
      "doc": "Error details if the provisioning failed"
    }
  ]
}