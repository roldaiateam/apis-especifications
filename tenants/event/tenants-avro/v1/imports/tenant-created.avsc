{
  "type": "record",
  "name": "TenantCreatedAvro",
  "namespace": "com.proactivedevs.contracts.tenants.v1",
  "doc": "Schema representing the data payload for a tenant created event",
  "fields": [
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Unique identifier for the tenant"
    },
    {
      "name": "tenantName",
      "type": "string",
      "doc": "Name of the tenant/organization"
    },
    {
      "name": "companyName",
      "type": "string",
      "doc": "Company name associated with the tenant"
    },
    {
      "name": "userId",
      "type": "string",
      "doc": "Identifier of the user who created the tenant"
    }
  ]
}
