{
  "type": "record",
  "name": "TenantCreatedEventEnvelope",
  "namespace": "com.proactivedevs.contracts.tenants.v1",
  "doc": "Event emitted when a new tenant is created",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique identifier for this event"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "tenant.created",
      "doc": "Type of event"
    },
    {
      "name": "timestamp1",
      "type": "string",
      "doc": "ISO 8601 timestamp when the event occurred"
    },
    {
      "name": "payload",
      "type": "TenantCreatedAvro",
      "doc": "Tenant data payload"
    },
    {
      "name": "metadata",
      "type": [
        "null",
        {
          "type": "map",
          "values": "string"
        }
      ],
      "default": null,
      "doc": "Optional metadata"
    }
  ]
}
