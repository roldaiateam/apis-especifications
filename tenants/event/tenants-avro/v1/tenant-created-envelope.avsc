{
  "type": "record",
  "name": "TenantCreatedEvent",
  "namespace": "com.proactivedevs.contracts.tenants.v1",
  "doc": "Event emitted when a new tenant is created",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique identifier for this event"
    },
    {
      "name": "eventType",
      "type": "string",
      "default": "tenant.created",
      "doc": "Type of event"
    },
    {
      "name": "timestamp",
      "type": "string",
      "doc": "ISO 8601 timestamp when the event occurred"
    },
    {
      "name": "tenantId",
      "type": "string",
      "doc": "Unique identifier for the tenant"
    },
    {
      "name": "tenantName",
      "type": "string",
      "doc": "Name of the tenant/organization"
    },
    {
      "name": "userName",
      "type": "string",
      "doc": "Name of the user who created the tenant"
    },
    {
      "name": "metadata",
      "type": [
        "null",
        {
          "type": "map",
          "values": "string"
        }
      ],
      "default": null,
      "doc": "Optional metadata for extensibility"
    }
  ]
}
